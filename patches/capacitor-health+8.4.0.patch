+            try {
+                if (!hasPermission(CapHealthPermission.READ_RESTING_HEART_RATE)) {
+                    call.reject("READ_RESTING_HEART_RATE permission not granted")
+                    return@launch
+                }
+                val timeRange = TimeRangeFilter.between(Instant.parse(startDate), Instant.parse(endDate))
+                val arr = JSArray()
+                var pageToken: String? = null
+                do {
+                    val request = ReadRecordsRequest(
+                        RestingHeartRateRecord::class,
+                        timeRange,
+                        emptySet(),
+                        true,
+                        1000,
+                        pageToken,
+                    )
