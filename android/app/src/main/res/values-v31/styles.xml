<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : l'écran de lancement système affiche l'icône de l'app sur cette couleur
         (bleu Novalyz, comme l'écran de chargement), puis splash.png prend le relais. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">#0B2A8A</item>
    </style>
</resources>
