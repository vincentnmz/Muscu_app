+    // ── Novalyz fork : sommeil + FC repos (non exposés par le plugin d'origine) ──
+    @PluginMethod
+    fun querySleep(call: PluginCall) {
+        val startDate = call.getString("startDate")
+        val endDate = call.getString("endDate")
+        if (startDate == null || endDate == null) {
+            call.reject("Missing required parameters: startDate or endDate")
+            return
+        }
+        CoroutineScope(Dispatchers.IO).launch {
+            try {
+                if (!hasPermission(CapHealthPermission.READ_SLEEP)) {
+                    call.reject("READ_SLEEP permission not granted")
+                    return@launch
+                }
+                val timeRange = TimeRangeFilter.between(Instant.parse(startDate), Instant.parse(endDate))
+                val sessions = JSArray()
+                var pageToken: String? = null
+                do {
+                    val request = ReadRecordsRequest(
+                        SleepSessionRecord::class,
+                        timeRange,
+                        emptySet(),
+                        true,
+                        1000,
+                        pageToken,
+                    )
+                    val response = healthConnectClient.readRecords(request)
+                    for (record in response.records) {
+                        val inBedMin = java.time.Duration.between(record.startTime, record.endTime).toMinutes()
+                        // Temps réellement endormi = somme des stades de sommeil (hors éveil).
+                        // Codes Health Connect : 2=SLEEPING, 4=LIGHT, 5=DEEP, 6=REM (endormi) ;
+                        // 1=AWAKE, 3=OUT_OF_BED, 7=AWAKE_IN_BED, 0=UNKNOWN (éveil). On utilise
+                        // les codes entiers pour ne dépendre d'aucune constante nommée.
+                        var asleepMin = 0L
+                        for (stage in record.stages) {
+                            val m = java.time.Duration.between(stage.startTime, stage.endTime).toMinutes()
+                            if (stage.stage == 2 || stage.stage == 4 || stage.stage == 5 || stage.stage == 6) asleepMin += m
+                        }
+                        val obj = JSObject()
+                        obj.put("startDate", record.startTime.toString())
+                        obj.put("endDate", record.endTime.toString())
+                        // durationMin = temps endormi si des stades existent, sinon temps au lit.
+                        obj.put("durationMin", if (asleepMin > 0) asleepMin else inBedMin)
+                        obj.put("asleepMin", asleepMin)
+                        obj.put("inBedMin", inBedMin)
+                        obj.put("sourceBundleId", record.metadata.dataOrigin.packageName)
+                        obj.put("sourceName", record.metadata.device?.model ?: "")
+                        sessions.put(obj)
+                    }
+                    pageToken = response.pageToken
+                } while (pageToken != null)
+                val result = JSObject()
+                result.put("sessions", sessions)
+                call.resolve(result)
+            } catch (e: Exception) {
+                call.reject("Error querying sleep: ${e.message}")
+            }
+        }
+    }
+
