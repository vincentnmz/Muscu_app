---
// Étiquette d'état honnête : ce qui existe, ce qui arrive, ce qui est prévu.
interface Props { etat: 'dispo' | 'bientot' | 'prevu' }
const { etat } = Astro.props;
const txt = { dispo: 'Disponible', bientot: 'Bientôt', prevu: 'Prévu' }[etat];
---
<span class:list={['st', etat]}>{txt}</span>
<style>
  .st { display: inline-block; font-family: var(--f-mark); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; padding: 5px 9px; border-radius: var(--r-pill); white-space: nowrap; }
  .dispo { background: var(--st-dispo-bg); color: var(--st-dispo); }
  .bientot { background: var(--st-bientot-bg); color: var(--st-bientot); }
  .prevu { background: var(--st-prevu-bg); color: var(--st-prevu); }
</style>
